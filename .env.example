# Copy to .env and fill in. Loaded automatically on startup (python-dotenv).
# .env is gitignored - never commit it.

# --- LLM provider: pick ONE ---------------------------------------------------

# Option A (default): Cursor SDK. Key from https://cursor.com/dashboard/integrations
# Only this provider supports the live web-search lookups (analyst consensus,
# fiscal/trade news); everything else still runs without them.
LLM_PROVIDER=cursor
CURSOR_API_KEY=

# Option B: any OpenAI-compatible endpoint (OpenAI, OpenRouter, Groq, Together,
# local Ollama / LM Studio ...). Uncomment and fill in:
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=gpt-5.6-luna
# LLM_BASE_URL=            # blank = api.openai.com; e.g. http://localhost:11434/v1 for Ollama

# --- Optional: WhatsApp summary via your OpenClaw gateway ---------------------
# E.164 number to receive the short summary when a run finishes. Leave blank to
# just write the report to reports/.
FINANCE_AGENT_WHATSAPP_TO=
